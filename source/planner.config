# planner.config - Configurazione motore di pianificazione, orari e routing
# Modificabile senza dover ricompilare o riavviare il codice.

# ==============================================================================
# Parametri Orari Lavorativi e Visite
# ==============================================================================
# Orario di inizio e fine giornata lavorativa (formato HH:MM)
WORK_START = "09:00"
WORK_END = "18:00"

# Finestra oraria consentita per l'inizio della pausa pranzo (formato HH:MM)
LUNCH_EARLIEST = "12:00"
LUNCH_LATEST_START = "14:00"

# Durata della pausa pranzo in minuti
LUNCH_DURATION_MINUTES = 60

# Tolleranza oraria (in minuti) oltre l'orario di lavoro per il rientro in sede
WORK_END_GRACE_MINUTES = 15

# Durata standard di default di una visita (in ore)
DEFAULT_VISIT_HOURS = 3.5

# Ore massime lavorative per giorno
MAX_WORK_HOURS_PER_DAY = 8.0

# ==============================================================================
# Regole Trasferte Remote
# ==============================================================================
# Tempo minimo di viaggio (in minuti) dalla sede per considerare una trasferta multi-giorno
MIN_TRASFERTA_TRAVEL_MINUTES = 120

# ==============================================================================
# Parametri Ottimizzatore Euristico (ALNS)
# ==============================================================================
# Tempo massimo di calcolo in secondi per la ricerca delle soluzioni migliori
PLANNING_TIME_LIMIT_SECONDS = 30

# Numero massimo di iterazioni per il loop ALNS
PLANNING_MAX_ITERATIONS = 500

# Moltiplicatore per il pool di candidati selezionati per cluster/giorno
PLANNING_POOL_MULTIPLIER = 5

# Seed per la riproducibilità stocastica dell'algoritmo
PLANNING_RANDOM_SEED = 42

# ==============================================================================
# Parametri Routing e OSRM
# ==============================================================================
# URL del server OSRM per le matrici di viaggio e calcolo percorsi
OSRM_BASE_URL = https://router.project-osrm.org

# Timeout per le richieste HTTP verso OSRM (in secondi)
OSRM_TIMEOUT_SECONDS = 8.0

# Numero massimo di candidati per query verso la matrice OSRM
MAX_ROUTING_CANDIDATES = 100

# Velocità media di fallback in km/h se OSRM non è raggiungibile
AVERAGE_FALLBACK_SPEED_KMH = 35.0
