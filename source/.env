# .env - Variabili di ambiente e coordinate mappa
MAP_CENTER_LAT=41.9028
MAP_CENTER_LON=12.4964

# Configurazione Photon Geocoding
UPDATE_INTERVAL=30d

# Imposta a "true" per usare il geocoder Photon locale, "false" per usare le API pubbliche 
USE_LOCAL_PHOTON=false 

# Avvio del container Photon (necessario se USE_LOCAL_PHOTON=true)
#COMPOSE_PROFILES=photon

# Parametri Java per Photon Locale 
JAVA_TOOL_OPTIONS=-Xms1g -Xmx2g
