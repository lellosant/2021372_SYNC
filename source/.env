# .env - Variabili di configurazione del progetto
DEFAULT_VISIT_HOURS=3.5
MAX_WORK_HOURS_PER_DAY=8.0
MAP_CENTER_LAT=41.9028
MAP_CENTER_LON=12.4964

# Configurazione orari di lavoro e pausa (formato HH:MM)
WORK_START="09:00"
WORK_END="18:00"
LUNCH_EARLIEST="12:00"
LUNCH_LATEST_START="14:00"
LUNCH_DURATION_MINUTES=60
WORK_END_GRACE_MINUTES=15

# Configurazione trasferte (tempo minimo di viaggio in minuti dalla sede per considerare una trasferta)
MIN_TRASFERTA_TRAVEL_MINUTES=120

# Configurazione ottimizzatore ALNS
PLANNING_TIME_LIMIT_SECONDS=30
PLANNING_MAX_ITERATIONS=500
